{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "http://localhost:5173",
    "UseHttpsRedirection": true
  },
  "Auth": {
    "RequireConfirmedEmail": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "CookieExpirationMinutes": 10080,
    "SecurityStampValidationMinutes": 5,
    "TokenLifespanHours": 24
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Api": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None",
      "FromAddress": "no-reply@languagelearning.local",
      "FromName": "LanguageLearning"
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
