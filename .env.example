# 複製為 .env 後填入實際值。.env 已列入 .gitignore，請勿提交。

# SQL Server SA 密碼（需由開發者提供）
# 規則：至少 8 碼，且包含大寫、小寫、數字、符號中的三種
MSSQL_SA_PASSWORD=

# 本機對外埠號
MSSQL_PORT=1433
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# 後端連線字串請以 user-secrets 設定（見 README），不要寫在此檔或 appsettings.json：
#   dotnet user-secrets --project src/backend/LanguageLearning.Api set "ConnectionStrings:Default" "Server=localhost,1433;Database=LanguageLearning;User Id=sa;Password=<與上方相同>;TrustServerCertificate=True;Encrypt=True"
#
# 初始管理者帳號（選填，需由開發者提供）：
#   dotnet user-secrets --project src/backend/LanguageLearning.Api set "Seed:Admin:Email" "<管理者 Email>"
#   dotnet user-secrets --project src/backend/LanguageLearning.Api set "Seed:Admin:Password" "<管理者密碼>"
