<Project>
  <!--
    產品版本號的唯一定義處（後端）。
    前端版本定義於 src/frontend/package.json，兩者必須一致（CI 與單元測試會檢查）。
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>LanguageLearning</Product>
    <Company>LanguageLearning</Company>
    <Copyright>Copyright © LanguageLearning</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 低 / 中風險套件弱點維持為警告；高 / 重大風險仍會使建置失敗。 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
